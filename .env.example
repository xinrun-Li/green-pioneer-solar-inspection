# ============================================
# 绿能先锋 · 环境变量配置
# 复制此文件为 .env 并按需修改
# ============================================

# ---- Django 核心 ----
# 调试模式：生产环境请设为 false
DJANGO_DEBUG=true
# Django 密钥：生产环境务必更换为强随机字符串（可用 openssl rand -hex 32 生成）
DJANGO_SECRET_KEY=change-me-in-local-env
# 允许访问的主机名，逗号分隔；生产环境添加域名
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ---- PostgreSQL 数据库 ----
# 数据库名称
POSTGRES_DB=green_pioneer
# 数据库用户名
POSTGRES_USER=green_pioneer
# 数据库密码：生产环境务必更换强密码
POSTGRES_PASSWORD=green_pioneer_dev
# 数据库主机地址（Docker Compose 中为服务名 postgres；本地开发可改为 localhost）
POSTGRES_HOST=postgres
# 数据库端口
POSTGRES_PORT=5432

# ---- Redis / Celery ----
# Redis 连接地址（Docker Compose 中为 redis://redis:6379/0；本地开发改为 redis://localhost:6379/0）
REDIS_URL=redis://redis:6379/0
# 设为 true 时由原生 Celery/AI Worker 异步执行；本地无 Worker 时保持 false
INFERENCE_ASYNC=false

# ---- YOLO 模型 ----
# 相对于 DATA_ROOT（默认 data/）的模型路径
YOLO_MODEL_PATH=models/solar-yolo11n-v1.pt

# ---- DeepSeek 智能助手 ----
# 在 https://platform.deepseek.com/api_keys 创建密钥；只填写在服务端 .env，勿写入前端代码
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_HISTORY=8

# ---- CORS / 跨域 ----
# 允许跨域的前端地址，逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:5173
# CSRF 可信来源（跨域 POST 必须与 CORS 一致），逗号分隔
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---- 前端构建 ----
# 前端 API 请求基地址（开发环境通过 Vite 代理转发）
VITE_API_BASE_URL=/api/v1

# ---- 可选：超级用户（bootstrap.sh 自动创建用） ----
# 如不设置，bootstrap.sh 将使用默认值 admin / admin@example.com / admin123456
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=admin123456
